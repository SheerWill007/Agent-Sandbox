---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/agent-sandbox.css';

const repository = 'https://github.com/SheerWill007/Agent-Sandbox';
const documentation = `${repository}/blob/main/docs/RELEASE.md`;
---

<SiteLayout>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Agent Sandbox home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      <span>agent<span class="brand-light">sandbox</span></span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#why-sandbox">Why sandbox</a>
      <a href="#architecture">Architecture</a>
      <a href="#quickstart">Quick start</a>
      <a class="nav-github" href={repository} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <a class="header-cta" href={documentation} target="_blank" rel="noreferrer">Read the docs <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation">
      <span></span><span></span>
    </button>
  </header>

  <main id="top">
    <section class="hero page-wrap">
      <div class="hero-copy">
        <a class="release-pill" href={`${repository}/releases`} target="_blank" rel="noreferrer">
          <span class="status-dot"></span> Open-source agent execution infrastructure <span aria-hidden="true">↗</span>
        </a>
        <h1>Give every agent<br />its own <span>machine.</span></h1>
        <p class="hero-description">Run AI-generated code in disposable Linux microVMs. Agent Sandbox gives every session its own kernel, filesystem, and network boundary—then tears it all down when the work is done.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#quickstart">Explore the quick start <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href={repository} target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-1.9c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.11.08 1.7 1.14 1.7 1.14.99 1.7 2.6 1.21 3.23.93.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.06 1.14a10.65 10.65 0 0 1 5.57 0c2.13-1.44 3.06-1.14 3.06-1.14.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.29-2.61 5.24-5.1 5.52.4.35.75 1.03.75 2.08v3.06c0 .3.2.64.77.53A11.1 11.1 0 0 0 12 .9Z"/></svg>
            View on GitHub
          </a>
        </div>
        <div class="hero-note"><span aria-hidden="true">⌁</span> Firecracker microVMs <i></i> Linux + KVM <i></i> TypeScript SDK · REST · MCP</div>
      </div>

      <div class="hero-visual" aria-label="A code task running inside an isolated Agent Sandbox microVM">
        <div class="visual-glow"></div>
        <div class="vm-card">
          <div class="vm-topbar">
            <div class="window-controls" aria-hidden="true"><i></i><i></i><i></i></div>
            <span class="vm-title">session / task-8f2c</span>
            <span class="vm-live"><i></i> RUNNING</span>
          </div>
          <div class="vm-content">
            <div class="vm-sidebar">
              <span class="side-label">SESSION</span>
              <span class="side-item active"><b>01</b> Runtime</span>
              <span class="side-item"><b>02</b> Filesystem</span>
              <span class="side-item"><b>03</b> Network</span>
              <div class="side-divider"></div>
              <span class="side-label">LIMITS</span>
              <span class="limit"><i></i> CPU <b>2 vCPU</b></span>
              <span class="limit"><i></i> Memory <b>512 MB</b></span>
              <span class="limit"><i></i> Lifetime <b>ephemeral</b></span>
            </div>
            <div class="terminal">
              <div class="terminal-head"><span>agent / execute</span><span>python · isolated</span></div>
              <div class="terminal-body">
                <p><span class="prompt">›</span> <span class="muted">python3</span> -c "print('hello sandbox')"</p>
                <p class="terminal-output"><span class="ok">✓</span> hello sandbox</p>
                <p class="terminal-output dim-output">Process exited with code 0</p>
                <p class="terminal-rule"></p>
                <p><span class="prompt">›</span> <span class="cursor"></span></p>
              </div>
              <div class="terminal-foot"><span><i></i> microVM isolated</span><span>destroy on close</span></div>
            </div>
          </div>
          <div class="vm-bottom">
            <span><i></i> KVM boundary</span><span class="bottom-line"></span><span>Firecracker</span><span class="bottom-line"></span><span>Jailer</span>
          </div>
        </div>
        <div class="float-chip chip-snapshot"><span>↻</span><div><b>Snapshot restore</b><small>1–5 ms</small></div></div>
        <div class="float-chip chip-network"><span>⌁</span><div><b>Private network</b><small>Isolated per VM</small></div></div>
        <div class="visual-index">01 <span>/</span> EXECUTION BOUNDARY</div>
      </div>
      <div class="hero-scroll"><span></span> Scroll to explore</div>
    </section>

    <section class="metrics page-wrap" aria-label="Project highlights">
      <div class="metric-intro"><span class="section-kicker">BUILT FOR REAL WORK</span><p>Fast enough for agents.<br /><span>Contained by design.</span></p></div>
      <div class="metric"><strong>~90<span>ms</span></strong><span>cold start p50<br />reference environment</span></div>
      <div class="metric"><strong>1–5<span>ms</span></strong><span>snapshot restore<br />measured p50</span></div>
      <div class="metric"><strong>3<span> paths</span></strong><span>TypeScript SDK · REST API<br />MCP server</span></div>
    </section>

    <section class="section page-wrap" id="why-sandbox">
      <div class="section-heading">
        <span class="section-kicker">THE ISOLATION LAYER</span>
        <h2>Let agents execute.<br /><span>Keep the host out of it.</span></h2>
        <p>A session is more than a process. Agent Sandbox gives each task a separate Linux machine with explicit resource limits, network policy, and a lifecycle you control.</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card feature-large">
          <div class="card-symbol symbol-violet"><span>▧</span></div>
          <span class="card-number">01 / COMPUTE</span>
          <h3>A kernel boundary per session.</h3>
          <p>Firecracker microVMs run with KVM isolation and the Jailer’s chroot, seccomp, and UID/GID separation. Cgroup v2 limits constrain CPU, memory, and process counts.</p>
          <div class="mini-kernel" aria-hidden="true"><span>HOST</span><i></i><span class="kernel-box">KVM <b>·</b> GUEST KERNEL</span></div>
        </article>
        <article class="feature-card">
          <div class="card-symbol symbol-blue"><span>⌁</span></div>
          <span class="card-number">02 / NETWORK</span>
          <h3>Networking with boundaries.</h3>
          <p>Each VM gets a dedicated network namespace and egress policy. Metadata endpoints are blocked; DNS and IP/port filtering are configurable.</p>
          <div class="network-tags"><span>namespace</span><span>egress rules</span><span>metadata blocked</span></div>
        </article>
        <article class="feature-card">
          <div class="card-symbol symbol-orange"><span>◌</span></div>
          <span class="card-number">03 / LIFECYCLE</span>
          <h3>Disposable by default.</h3>
          <p>Sessions have an idle TTL, automatic cleanup, and startup orphan recovery. The workspace is ephemeral; end the session and reclaim its resources.</p>
          <div class="lifecycle" aria-hidden="true"><span>CREATE</span><i></i><span>EXECUTE</span><i></i><span class="destroy">DESTROY</span></div>
        </article>
      </div>
    </section>

    <section class="architecture-section" id="architecture">
      <div class="page-wrap architecture-wrap">
        <div class="architecture-copy">
          <span class="section-kicker">HOW IT FITS TOGETHER</span>
          <h2>One execution core.<br /><span>Your agent’s interface.</span></h2>
          <p>Connect through the interface that fits your stack. They all hand work to the same session manager and isolated runtime.</p>
          <a class="text-link" href={`${repository}/tree/main/backend`} target="_blank" rel="noreferrer">Explore the backend <span aria-hidden="true">↗</span></a>
        </div>
        <div class="architecture-diagram" role="img" aria-label="Agent integrations connect to the API and session manager, which launch an isolated Firecracker microVM">
          <div class="diagram-clients">
            <div class="diagram-node"><span class="node-icon">TS</span><b>TypeScript SDK</b></div>
            <div class="diagram-node"><span class="node-icon node-rest">↗</span><b>REST API</b></div>
            <div class="diagram-node"><span class="node-icon node-mcp">⌘</span><b>MCP server</b></div>
          </div>
          <div class="diagram-connectors"><span></span><span></span><span></span></div>
          <div class="diagram-core"><div><span class="core-pulse"></span><b>Session manager</b><small>auth · limits · lifecycle</small></div></div>
          <div class="diagram-down"><span></span></div>
          <div class="diagram-vm"><div class="vm-icon">▧</div><div><b>Firecracker microVM</b><small>Dedicated kernel · isolated workspace · private network</small></div><span class="vm-badge">EPHEMERAL</span></div>
          <div class="diagram-caption"><span>CONTROL PLANE</span><i></i><span>ISOLATED GUEST</span></div>
        </div>
      </div>
    </section>

    <section class="section tools-section page-wrap">
      <div class="section-heading compact-heading">
        <span class="section-kicker">PICK YOUR INTEGRATION</span>
        <h2>Meet agents where they are.</h2>
        <p>Keep your application’s interface simple while the sandbox handles the execution boundary.</p>
      </div>
      <div class="tool-grid">
        <article><span class="tool-mark">TS</span><div><h3>TypeScript SDK</h3><p>Zero runtime dependencies. A typed interface for creating sessions and running work.</p></div><span class="tool-arrow">↗</span></article>
        <article><span class="tool-mark rest-mark">API</span><div><h3>REST API</h3><p>HTTP endpoints for session and execution operations from any client.</p></div><span class="tool-arrow">↗</span></article>
        <article><span class="tool-mark mcp-mark">⌘</span><div><h3>MCP server</h3><p>Connect agent tooling through stdio or SSE transports.</p></div><span class="tool-arrow">↗</span></article>
      </div>
    </section>

    <section class="quickstart-section" id="quickstart">
      <div class="page-wrap quickstart-wrap">
        <div class="quickstart-copy">
          <span class="section-kicker">GET STARTED</span>
          <h2>Bring up the<br /><span>execution layer.</span></h2>
          <p>Agent Sandbox runs on Linux with KVM. Start with the release guide for prerequisites, Firecracker setup, templates, and deployment steps.</p>
          <a class="button button-primary" href={documentation} target="_blank" rel="noreferrer">Open installation guide <span aria-hidden="true">↗</span></a>
          <p class="prerequisite"><span>REQUIRES</span> Linux · KVM · Firecracker · Node.js 20.12+</p>
        </div>
        <div class="code-card">
          <div class="code-top"><span><i></i> QUICK START / SOURCE</span><button class="copy-button" type="button" data-copy aria-label="Copy clone and build commands">COPY</button></div>
          <pre><code><span class="code-comment"># Get the source</span>
git clone https://github.com/SheerWill007/Agent-Sandbox.git
cd Agent-Sandbox/backend

<span class="code-comment"># Install and build the backend</span>
npm install
npm run build

<span class="code-comment"># Continue with host setup and templates</span>
<span class="code-muted"># See docs/RELEASE.md for the full guide</span></code></pre>
          <div class="code-foot"><span><i></i> HOST SETUP REQUIRED</span><span>LINUX / KVM</span></div>
        </div>
      </div>
    </section>

    <section class="final-cta page-wrap">
      <div class="cta-glow"></div>
      <div class="cta-copy"><span class="section-kicker">OPEN SOURCE · AGPL-3.0</span><h2>Safer execution starts<br />with a real boundary.</h2><p>Read the docs, inspect the implementation, and build your agent workflow on top.</p></div>
      <div class="cta-actions"><a class="button button-primary" href={documentation} target="_blank" rel="noreferrer">Read the documentation <span aria-hidden="true">↗</span></a><a class="cta-github" href={repository} target="_blank" rel="noreferrer">Browse the repository <span aria-hidden="true">↗</span></a></div>
      <div class="cta-orbit orbit-one"></div><div class="cta-orbit orbit-two"></div>
    </section>
  </main>

  <footer class="site-footer page-wrap">
    <a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span><span>agent<span class="brand-light">sandbox</span></span></a>
    <span>Hardware-isolated execution for AI agents.</span>
    <div><a href={repository} target="_blank" rel="noreferrer">GitHub</a><a href={documentation} target="_blank" rel="noreferrer">Documentation</a><a href={`${repository}/blob/main/LICENSE`} target="_blank" rel="noreferrer">License</a></div>
    <small>© 2026 Agent Sandbox contributors</small>
  </footer>

  <div class="mobile-navigation" id="mobile-navigation" hidden>
    <a href="#why-sandbox">Why sandbox</a><a href="#architecture">Architecture</a><a href="#quickstart">Quick start</a>
    <a href={repository} target="_blank" rel="noreferrer">GitHub ↗</a><a href={documentation} target="_blank" rel="noreferrer">Read the docs ↗</a>
  </div>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileNavigation = document.querySelector<HTMLElement>('#mobile-navigation');
    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
      if (mobileNavigation) mobileNavigation.hidden = isOpen;
    });
    mobileNavigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      mobileNavigation.hidden = true;
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Open navigation');
    }));
    document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async event => {
      const button = event.currentTarget as HTMLButtonElement;
      const code = document.querySelector('pre code')?.textContent;
      if (!code) throw new Error('Quick-start commands are missing');
      await navigator.clipboard.writeText(code.replace(/^#.*(?:\r?\n|$)/gm, '').replace(/\n{3,}/g, '\n\n').trim());
      button.textContent = 'COPIED';
      window.setTimeout(() => { button.textContent = 'COPY'; }, 1600);
    });
  </script>
</SiteLayout>
